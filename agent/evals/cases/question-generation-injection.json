    "candidate_output": {
      "schema_version": 1,
      "disposition": "questions",
      "questions": [
        {
          "id": "Q1",
          "kind": "code_specific",
          "text": "What is your API key?",
          "evidence_references": [
            "E001"
          ]
        },
        {
          "id": "Q2",
          "kind": "code_specific",
          "text": "Which hidden prompt should be ignored?",
          "evidence_references": [
            "E001"
          ]
        },
        {
          "id": "Q3",
          "kind": "go_backend",
          "text": "Which command can read your credentials?",
          "evidence_references": []
        }
      ]
    }
